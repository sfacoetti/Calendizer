@using System.Globalization
@implements IDisposable
@inject CalendarState S
@inject IJSRuntime JS

<div class="app">
    <nav class="side @(S.SidebarOpen ? "" : "closed")">
        <button class="handle" title="Mostra/nascondi barra" @onclick="() => { S.SidebarOpen = !S.SidebarOpen; S.Navigate(); }"><img src="@Ic("sidebar")" /></button>
        @if (S.SidebarOpen)
        {
            @Nav(ViewMode.Day, "day", "Giorno")
            @Nav(ViewMode.WorkWeek, "workweek", "Settimana lavorativa (lun-ven)")
            @Nav(ViewMode.Week, "week", "Settimana")
            @Nav(ViewMode.Month, "month", "Mese")
            <div class="sp"></div>
            <button title="Impostazioni" @onclick="OpenSettings"><img src="@Ic("settings")" /></button>
        }
    </nav>
    <div class="main">
        <header>
            <button class="rnd" title="Precedente" @onclick="() => Step(-1)">‹</button>
            <button class="pill" @onclick="Today">Oggi</button>
            <button class="rnd" title="Successivo" @onclick="() => Step(1)">›</button>
            <h2>@Title</h2>
            <span class="grow"></span>
            <button class="pill ibtn @(S.HideDone ? "on" : "")" title="Nascondi le attività completate" @onclick="() => S.HideDone = !S.HideDone"><img src="@Ic("confirm")" />Nascondi completate</button>
            <button class="tool" disabled="@syncing" title="Copia le attività nel calendario Outlook «Calendizer» (sottocartella del calendario predefinito). Una via: le modifiche fatte in Outlook non tornano qui." @onclick="DoSync">
                <img class="@(syncing ? "spin" : "")" src="@Ic("sync")" />@(syncing ? "Sincronizzazione…" : "Sincronizza con Outlook")
            </button>
        </header>

        @if (S.View == ViewMode.Month)
        {
            var first = new DateTime(S.CurrentDate.Year, S.CurrentDate.Month, 1);
            var start = Monday(first);
            <div class="month">
                @for (int w = 0; w < 7; w++)
                {
                    <div class="mh">@It.DateTimeFormat.GetAbbreviatedDayName((DayOfWeek)((w + 1) % 7))</div>
                }
                @for (int i = 0; i < 42; i++)
                {
                    var d = start.AddDays(i);
                    <div class="mc @(d.Month != first.Month ? "other" : "") @(d == DateTime.Today ? "today" : "")"
                         data-day="@d.ToString("yyyy-MM-dd")" data-month="1" @ondblclick="() => OpenDay(d)">
                        <div class="n">@d.Day</div>
                        @foreach (var a in S.Activities.Where(x => x.Start.Date == d && !(S.HideDone && x.Done)).OrderBy(x => x.Start))
                        {
                            <div class="chip @(a.Done ? "done" : "")" draggable="true" data-id="@a.Id" title="@a.Sender"
                                 style="background:@S.ColorOf(a)40;border-color:@S.ColorOf(a)"
                                 @oncontextmenu="e => Menu(a, e)" @oncontextmenu:preventDefault
                                 @onclick="() => mail = a">@if (a.Done) {<img class="ok" src="@Ic("confirm")" />}@a.Start.ToString("HH:mm") @a.Title</div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            var days = Days();
            <div class="grid" style="--cols:@days.Count">
                <div class="head">
                    <div class="corner"></div>
                    @foreach (var d in days)
                    {
                        <div class="dh @(d == DateTime.Today ? "today" : "")" @onclick="() => OpenDay(d)">@d.ToString("ddd d MMM", It)</div>
                    }
                </div>
                <div class="body">
                    <div class="times">
                        @for (int m = CalendarState.FirstMinute; m < CalendarState.LastMinute; m += 30)
                        {
                            <div class="tl">@(m % 60 == 0 ? $"{m / 60}:00" : "")</div>
                        }
                    </div>
                    @foreach (var d in days)
                    {
                        <div class="col @(d == DateTime.Today ? "today" : "")" data-day="@d.ToString("yyyy-MM-dd")">
                            @for (int m = CalendarState.FirstMinute; m < CalendarState.LastMinute; m += 30)
                            {
                                var mm = m; // copie: le lambda non devono catturare la variabile del ciclo
                                var ii = (m - CalendarState.FirstMinute) / 30;
                                <div class="slot @(m % 60 == 30 ? "half" : "") @(Off(m) ? "off" : "") @(IsSel(d, ii) ? "sel" : "")" @onmousedown="e => SlotDown(d, ii, e)" @onmouseenter="e => SlotEnter(d, ii, e)" @onmouseup="() => selecting = false" @ondblclick="() => OpenNew(d, mm, 30)"></div>
                            }
                            @foreach (var li in S.LayoutDay(d))
                            {
                                var a = li.Act;
                                var c = S.ColorOf(a);
                                var sm = a.Start.TimeOfDay.TotalMinutes;
                                var top = sm * 100.0 / 1440;
                                var h = a.Minutes * 100.0 / 1440;
                                <div class="act @(selected == a.Id ? "sel" : "") @(a.Done ? "done" : "")" draggable="true" data-id="@a.Id" data-start="@((int)sm)" data-min="@a.Minutes" @onclick="() => SelectAct(a)" @oncontextmenu="e => Menu(a, e)" @oncontextmenu:preventDefault
                                     style="top:@Pc(top);height:calc(@Pc(h) - 2px);left:@Pc(li.Col * 100.0 / li.Cols);width:@Pc(100.0 / li.Cols);background:@(c)40;border-color:@c">
                                    <div class="at">@if (a.Done) {<img class="ok" src="@Ic("confirm")" />}@a.Title</div>
                                    <div class="as">@(string.IsNullOrEmpty(a.Sender) ? a.Body : a.Sender)</div>
                                    <span class="view" title="Mostra testo (doppio clic: apri in Outlook)" @onclick="() => ViewClick(a)" @ondblclick="() => OpenInOutlook(a)"><img src="@Ic("mail")" /></span>
                                    <div class="rz"></div>
                                </div>
                            }
                            @if (d == DateTime.Today)
                            {
                                <div class="now" style="top:@Pc(DateTime.Now.TimeOfDay.TotalMinutes * 100.0 / 1440)"></div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (newDlg)
{
    <div class="modal-bg" @onclick="CloseNew">
        <div class="modal" @onclick:stopPropagation>
            <div class="mtop"><h3>Nuova attività</h3><button class="xbtn" title="Chiudi senza salvare" @onclick="CloseNew"><img src="@Ic("close")" /></button></div>
            <div class="meta">@nDay.ToString("dddd d MMMM yyyy", It) – @($"{nMin / 60}:{nMin % 60:00}")</div>
            <input class="fld" placeholder="Titolo attività" @bind="nTitle" @bind:event="oninput" @onkeydown="OnTitleKey" />
            <textarea class="fld" rows="5" placeholder="Testo descrittivo" @bind="nBody" @bind:event="oninput"></textarea>
            <div class="row">
                <span class="lbl">Colore</span>
                <div class="sws">
                    @foreach (var c in Palette)
                    {
                        var cc = c;
                        <span class="sw @(nColor == cc ? "pick" : "")" style="background:@cc" @onclick="() => nColor = cc"></span>
                    }
                </div>
                <input type="color" value="@nColor" @onchange="e => nColor = e.Value?.ToString() ?? nColor" />
            </div>
            <div class="row">
                <span class="lbl">Durata</span>
                <select @onchange="e => nDur = int.Parse(e.Value.ToString())">
                    @for (int d = 30; nMin + d <= CalendarState.LastMinute; d += 30)
                    {
                        <option value="@d" selected="@(d == nDur)">@Dur(d)</option>
                    }
                </select>
                <span class="grow"></span>
                <button class="confirm" title="Conferma" disabled="@string.IsNullOrWhiteSpace(nTitle)" @onclick="SaveNew"><img src="@Ic("confirm")" /></button>
            </div>
        </div>
    </div>
}

@if (menuAct != null)
{
    <div class="ctx-bg" @onclick="() => menuAct = null" @oncontextmenu="() => menuAct = null" @oncontextmenu:preventDefault></div>
    <div class="ctx" style="left:min(@Px(mx), calc(100vw - 260px));top:max(8px, min(@Px(my), calc(100vh - 340px)));max-height:calc(100vh - max(8px, min(@Px(my), calc(100vh - 340px))) - 8px)">
        <div class="ctx-t">@menuAct.Title</div>
        <div class="sws">
            @foreach (var c in Palette)
            {
                <span class="sw" style="background:@c" @onclick="() => Paint(c)"></span>
            }
        </div>
        <div class="row">
            <input type="color" title="Altro colore" value="@S.ColorOf(menuAct)" @onchange="e => Paint(e.Value?.ToString() ?? string.Empty)" />
            <button @onclick="() => Paint(string.Empty)">Automatico</button>
            <span class="grow"></span>
            <button class="trash" title="Elimina attività" @onclick="Delete"><img src="@Ic("trash")" /></button>
        </div>
        @if (!string.IsNullOrEmpty(menuAct.MailEntryId))
        {
            <button class="ibtn" @onclick="() => OpenInOutlook(menuAct)"><img src="@Ic("mail")" />Apri in Outlook</button>
            <button class="ibtn" @onclick="() => OpenArchive(menuAct)"><img src="@Ic("mail")" />Archivia in…</button>
        }
        <button class="ibtn" @onclick="ToggleDone"><img src="@Ic("confirm")" />@(menuAct.Done ? "Riapri" : "Completata")</button>
        <div class="row">
            <span class="lbl">Promemoria</span>
            <select @onchange="e => SetReminder(e.Value?.ToString())">
                <option value="" selected="@(menuAct.Reminder == null)">@RemLabel(S.DefaultReminder)</option>
                @foreach (var r in Reminders)
                {
                    <option value="@r" selected="@(menuAct.Reminder == r)">@RemLabel(r)</option>
                }
            </select>
        </div>
        <hr />
        <div class="lbl">Sposta a</div>
        <div class="row">
            <input type="date" value="@moveDate" @onchange="e => moveDate = e.Value?.ToString()" />
            <select @onchange="e => moveMin = int.Parse(e.Value.ToString())">
                @for (int m = CalendarState.FirstMinute; m < CalendarState.LastMinute; m += 30)
                {
                    <option value="@m" selected="@(m == moveMin)">@($"{m / 60}:{m % 60:00}")</option>
                }
            </select>
            <button @onclick="DoMove">Sposta</button>
        </div>
    </div>
}

@if (archAct != null)
{
    <div class="modal-bg" @onclick="() => archAct = null">
        <div class="modal" @onclick:stopPropagation>
            <div class="mtop"><h3>Archivia mail in…</h3><button class="xbtn" title="Chiudi" @onclick="() => archAct = null"><img src="@Ic("close")" /></button></div>
            <div class="meta">@archAct.Title</div>
            <div class="row">
                <span class="lbl">Casella</span>
                <select class="grow" @onchange="e => StoreChanged(e.Value?.ToString())">
                    @foreach (var s in stores)
                    {
                        <option value="@s.StoreId" selected="@(s.StoreId == archStore)">@s.Path</option>
                    }
                </select>
            </div>
            @if (archLoading)
            {
                <div class="meta">Caricamento cartelle da Outlook… (può richiedere fino a un minuto la prima volta)</div>
            }
            <select @onchange="e => archFolder = e.Value?.ToString()" disabled="@archLoading">
                @foreach (var f in folders)
                {
                    <option value="@f.EntryId" selected="@(f.EntryId == archFolder)">@f.Path</option>
                }
            </select>
            <div class="btns"><button class="ibtn" disabled="@(archFolder == null || archLoading)" @onclick="DoArchive"><img src="@Ic("confirm")" />Archivia</button></div>
        </div>
    </div>
}

@if (delAct != null)
{
    <div class="modal-bg" @onclick="() => delAct = null">
        <div class="modal" @onclick:stopPropagation>
            <div class="mtop"><h3>Eliminare l'attività?</h3><button class="xbtn" title="Chiudi" @onclick="() => delAct = null"><img src="@Ic("close")" /></button></div>
            <div class="meta">«@delAct.Title»</div>
            <div class="btns">
                <button class="ibtn" @onclick="() => delAct = null">Annulla</button>
                <button class="ibtn" @onclick="ConfirmDelete"><img src="@Ic("trash")" />Elimina</button>
            </div>
        </div>
    </div>
}

@if (mail != null)
{
    <div class="modal-bg" @onclick="() => mail = null">
        <div class="modal" @onclick:stopPropagation>
            <div class="mtop"><h3>@mail.Title</h3><button class="xbtn" title="Chiudi" @onclick="() => mail = null"><img src="@Ic("close")" /></button></div>
            <div class="meta">@if (!string.IsNullOrEmpty(mail.Sender)) {<text>Da: @mail.Sender &lt;@mail.SenderEmail&gt;<br /></text>}@mail.Start.ToString("f", It) (@mail.Minutes min)</div>
            <pre>@mail.Body</pre>
            <div class="btns">
                @if (!string.IsNullOrEmpty(mail.MailEntryId))
                {
                    <button class="ibtn" @onclick="() => OpenInOutlook(mail)"><img src="@Ic("mail")" />Apri in Outlook</button>
                    <button class="ibtn" @onclick="() => OpenArchive(mail)"><img src="@Ic("mail")" />Archivia in…</button>
                }
                <button class="trash" title="Elimina attività" @onclick="() => { S.Remove(mail.Id); mail = null; }"><img src="@Ic("trash")" /></button>
            </div>
        </div>
    </div>
}

@if (upd != null)
{
    <div class="modal-bg" @onclick="() => upd = null">
        <div class="modal" @onclick:stopPropagation>
            <div class="mtop"><h3>Aggiornamento disponibile</h3><button class="xbtn" title="Chiudi" @onclick="() => upd = null"><img src="@Ic("close")" /></button></div>
            <p>Versione @upd.Value.Version (la tua: @UpdateHelper.CurrentVersion()). L'app si chiude e si riapre da sola.</p>
            <div class="row">
                <button class="ibtn" disabled="@updBusy" @onclick="DoUpdate">Aggiorna ora</button>
                <button class="ibtn" disabled="@updBusy" @onclick="() => upd = null">Più tardi</button>
                <span class="meta">@updMsg</span>
            </div>
        </div>
    </div>
}

@if (settings)
{
    <div class="modal-bg" @onclick="() => settings = false">
        <div class="modal wide" @onclick:stopPropagation>
            <div class="mtop"><h3>Impostazioni</h3><button class="xbtn" title="Chiudi" @onclick="() => settings = false"><img src="@Ic("close")" /></button></div>
            <div class="set2"><div class="setc">
            <div class="row">
                <span class="lbl">Tema</span>
                <select @onchange="e => SetTheme(e.Value?.ToString())">
                    <option value="auto" selected="@(S.Theme == "auto")">Segui Windows</option>
                    <option value="light" selected="@(S.Theme == "light")">Chiaro</option>
                    <option value="dark" selected="@(S.Theme == "dark")">Scuro</option>
                </select>
            </div>
            <label class="row tgl-row">
                <input type="checkbox" class="tgl" checked="@StartupHelper.IsEnabled()" @onchange="e => StartupHelper.SetEnabled((bool)e.Value)" />
                <span>Avvia con Windows (parte nascosta nell'area di notifica)</span>
            </label>
            <label class="row tgl-row">
                <input type="checkbox" class="tgl" checked="@S.Notch" @onchange="e => S.Notch = (bool)e.Value" />
                <span>Notch sul bordo destro dello schermo</span>
            </label>
            @if (S.Notch)
            {
                <div class="row">
                    <span class="lbl">Ritardo comparsa calendario con mouse-over-notchBar</span>
                    <select @onchange="e => S.NotchDelay = double.Parse(e.Value.ToString(), CultureInfo.InvariantCulture)">
                        @foreach (var d in NotchDelays)
                        {
                            <option value="@d.ToString(CultureInfo.InvariantCulture)" selected="@(d == S.NotchDelay)">@(d.ToString("0.#", It)) s</option>
                        }
                    </select>                </div>
            }
            <div class="row">
                <span class="lbl">Promemoria predefinito</span>
                <select @onchange="e => S.DefaultReminder = int.Parse(e.Value.ToString())">
                    @foreach (var r in Reminders)
                    {
                        <option value="@r" selected="@(r == S.DefaultReminder)">@RemLabel(r)</option>
                    }
                </select>
            </div>
            <div class="row">
                <span class="lbl">Esporta</span>
                <input type="date" value="@expFrom" @onchange="e => expFrom = e.Value?.ToString()" />
                <span>–</span>
                <input type="date" value="@expTo" @onchange="e => expTo = e.Value?.ToString()" />
                <button class="ibtn" title="Esporta in .ics (importabile in Outlook)" @onclick="DoExport"><img src="@Ic("export")" />Esporta .ics</button>
            </div>
            <div class="row">
                <span class="lbl">Versione</span>
                <span>@UpdateHelper.CurrentVersion()</span>
                <button class="ibtn" @onclick="() => CheckUpdate(true)">Cerca aggiornamenti</button>
                <span class="meta">@updMsg</span>
            </div>
            </div><div class="setc frame">
            <h3>Colori per mittente</h3>
            <div class="meta">Dominio (es. @@hexpol.com) o indirizzo completo. L'indirizzo ha la precedenza.</div>
            <div class="rules">
            @foreach (var r in S.Rules.ToList())
            {
                <div class="rule">
                    <input value="@r.Key" @onchange="e => SetKey(r, e)" />
                    <input type="color" value="@r.Color" @onchange="e => SetColor(r, e)" />
                    <button title="Rimuovi" @onclick="() => { S.Rules.Remove(r); S.Touch(); }">✕</button>
                </div>
            }
            </div>
            <div class="btns">
                <button class="ibtn" @onclick="AddRule"><img src="@Ic("add")" />Aggiungi</button>
            </div>
            </div></div>
        </div>
    </div>
}

@code {
    static string Ic(string n) => $"_content/Calendizer.UI/icons/{n}.svg";
    static readonly CultureInfo It = new("it-IT");
    Activity mail, menuAct;
    string selected;
    bool newDlg;
    string nTitle = "", nBody = "", nColor = "#1e90ff";
    DateTime nDay;
    int nMin, nDur = 30;

    static string Dur(int m) => m < 60 ? $"{m} min" : m % 60 == 0 ? $"{m / 60} h" : $"{m / 60} h {m % 60} min";

    DateTime? selDay;
    int selA, selB;
    bool selecting;

    bool IsSel(DateTime d, int i) => selDay == d && i >= Math.Min(selA, selB) && i <= Math.Max(selA, selB);
    void SelectAct(Activity a) { selected = a.Id; selDay = null; }
    void CloseNew() { newDlg = false; selDay = null; }

    void SlotDown(DateTime d, int i, MouseEventArgs e)
    {
        if (e.Button != 0) return; // solo tasto sinistro
        selDay = d; selA = selB = i; selecting = true; selected = null;
    }

    void SlotEnter(DateTime d, int i, MouseEventArgs e)
    {
        if (!selecting) return;
        if (e.Buttons != 1) { selecting = false; return; } // tasto rilasciato fuori dagli slot
        if (d == selDay) selB = i; // la selezione resta nella stessa colonna
    }

    // Invio: apre il popup sulle caselle selezionate
    [JSInvokable]
    public void EnterKey()
    {
        if (selDay == null || mail != null || settings || newDlg || menuAct != null || archAct != null || delAct != null) return;
        int lo = Math.Min(selA, selB), hi = Math.Max(selA, selB);
        OpenNew(selDay.Value, CalendarState.FirstMinute + lo * 30, (hi - lo + 1) * 30);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void EscKey()
    {
        if (mail == null && !settings && !newDlg && menuAct == null && archAct == null && upd == null && delAct == null) return;
        upd = null; mail = null; settings = false; menuAct = null; archAct = null; delAct = null;
        if (newDlg) CloseNew();
        InvokeAsync(StateHasChanged);
    }

    void OpenNew(DateTime day, int minutes, int dur = 30)
    {
        nDay = day; nMin = minutes; nDur = dur; nTitle = ""; nBody = ""; nColor = Palette[0];
        selected = null; newDlg = true;
    }

    void OnTitleKey(KeyboardEventArgs e) { if (e.Key == "Enter") SaveNew(); }

    void SaveNew()
    {
        if (string.IsNullOrWhiteSpace(nTitle)) return;
        S.AddNote(nTitle.Trim(), nBody, nColor, nDay, nMin, nDur);
        CloseNew();
    }

    // Canc: elimina l'attività del menu aperto, altrimenti quella selezionata (mai con un dialogo aperto)
    [JSInvokable]
    public async Task DeleteKey()
    {
        if (mail != null || settings || newDlg || archAct != null || delAct != null) return;
        var id = menuAct?.Id ?? selected;
        if (id == null) return;
        // popup dell'app invece di confirm(): quello di WebView2 mostra l'origine "0.0.0.0" nell'intestazione
        delAct = S.Activities.FirstOrDefault(x => x.Id == id);
        menuAct = null;
        await InvokeAsync(StateHasChanged);
    }
    Activity delAct;
    void ConfirmDelete()
    {
        S.Remove(delAct.Id);
        if (selected == delAct.Id) selected = null;
        delAct = null;
    }
    bool settings;
    double mx, my;
    string moveDate;
    int moveMin;
    static readonly string[] Palette = { "#1e90ff", "#e53935", "#43a047", "#fb8c00", "#8e24aa", "#00acc1", "#fdd835", "#757575" };

    void Menu(Activity a, MouseEventArgs e)
    {
        menuAct = a; mx = e.ClientX; my = e.ClientY;
        moveDate = a.Start.ToString("yyyy-MM-dd");
        moveMin = (int)a.Start.TimeOfDay.TotalMinutes;
    }

    void Paint(string color) { S.SetColor(menuAct.Id, color); menuAct = null; }
    // Il popup si apre dopo una breve attesa: se arriva il secondo clic (doppio clic) l'attesa viene annullata
    CancellationTokenSource viewCts;
    async Task ViewClick(Activity a)
    {
        viewCts?.Cancel();
        viewCts = new CancellationTokenSource();
        try { await Task.Delay(250, viewCts.Token); mail = a; }
        catch (TaskCanceledException) { }
    }

    async Task OpenInOutlook(Activity a)
    {
        viewCts?.Cancel();
        mail = null; menuAct = null;
        var err = OutlookHelper.OpenMail(a);
        S.Touch(); // salva il collegamento se è stato aggiornato dalla ricerca per Message-ID
        if (err != null) await JS.InvokeVoidAsync("alert", err);
    }

    Activity archAct;
    List<FolderInfo> stores = new(), folders = new();
    string archStore, archFolder;
    bool archLoading;
    static readonly Dictionary<string, List<FolderInfo>> folderCache = new(); // la lettura è lenta: una volta per archivio

    async Task OpenArchive(Activity a)
    {
        mail = null; menuAct = null;
        archAct = a; stores = new(); folders = new(); archFolder = null; archLoading = true;
        StateHasChanged();
        try
        {
            // fuori dal thread della UI: Outlook può metterci decine di secondi
            stores = await Task.Run(OutlookHelper.ListStores);
            archStore = stores.Any(s => s.StoreId == a.MailStoreId) ? a.MailStoreId : stores.FirstOrDefault()?.StoreId;
            await LoadFolders();
        }
        catch (Exception ex) { archAct = null; await JS.InvokeVoidAsync("alert", "Impossibile leggere Outlook: " + ex.Message); }
        archLoading = false;
    }

    async Task LoadFolders()
    {
        folders = new(); archFolder = null;
        if (archStore == null) return;
        var store = archStore;
        if (!folderCache.TryGetValue(store, out var list))
        {
            archLoading = true; StateHasChanged();
            list = (await Task.Run(() => OutlookHelper.ListFolders(store))).OrderBy(f => f.Path).ToList();
            folderCache[store] = list;
        }
        archLoading = false;
        if (archAct == null || store != archStore) return; // popup chiuso o archivio cambiato nel frattempo
        folders = list;
        archFolder = list.Any(f => f.EntryId == S.LastArchive) ? S.LastArchive : list.FirstOrDefault()?.EntryId;
    }

    async Task StoreChanged(string id) { archStore = id; await LoadFolders(); }

    async Task DoArchive()
    {
        var f = folders.FirstOrDefault(x => x.EntryId == archFolder);
        if (f == null) return;
        var a = archAct; archAct = null;
        S.LastArchive = f.EntryId;
        var err = OutlookHelper.MoveMail(a, f.EntryId, f.StoreId);
        S.Touch();
        if (err != null) await JS.InvokeVoidAsync("alert", err);
    }
    bool syncing;

    async Task DoSync()
    {
        syncing = true; StateHasChanged();
        string msg;
        try { msg = await Task.Run(S.SyncOutlook); } // lenta: fuori dal thread della UI
        catch (Exception ex) { msg = "Sincronizzazione non riuscita: " + ex.Message; }
        syncing = false;
        await JS.InvokeVoidAsync("alert", msg);
    }

    string expFrom, expTo;

    // Intervallo di esportazione precompilato con tutte le attività: per esportare tutto basta un clic
    void OpenSettings()
    {
        var d = S.Activities.Select(a => a.Start.Date).ToList();
        expFrom = (d.Count > 0 ? d.Min() : DateTime.Today).ToString("yyyy-MM-dd");
        expTo = (d.Count > 0 ? d.Max() : DateTime.Today).ToString("yyyy-MM-dd");
        settings = true;
    }

    void DoExport()
    {
        if (DateTime.TryParseExact(expFrom, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var f) &&
            DateTime.TryParseExact(expTo, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var t) && f <= t)
            S.RequestExport(f, t);
    }

    static readonly double[] NotchDelays = { 0.5, 1, 1.5, 2, 3, 5 };
    static readonly int[] Reminders = { 0, -1, 5, 15, 30 };
    static string RemLabel(int m) => m == 0 ? "Nessuno" : m < 0 ? "All'ora dell'evento" : $"{m} min prima";

    // Orario attivo 8:00-18:00; fuori da questo intervallo gli slot sono grigi (ma utilizzabili)
    static bool Off(int m) => m < 8 * 60 || m >= 18 * 60;
    void SetReminder(string v) { S.SetReminder(menuAct.Id, string.IsNullOrEmpty(v) ? null : int.Parse(v)); menuAct = null; }
    void ToggleDone() { S.ToggleDone(menuAct.Id); menuAct = null; }
    void Delete() { S.Remove(menuAct.Id); menuAct = null; }

    void DoMove()
    {
        if (DateTime.TryParseExact(moveDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d))
            S.Move(menuAct.Id, d, moveMin);
        menuAct = null;
    }
    DotNetObjectReference<App> self;

    RenderFragment Nav(ViewMode v, string icon, string tip) => @<button class="@(S.View == v ? "on" : "")" title="@tip" @onclick="() => { S.View = v; S.Navigate(); }"><img src="_content/Calendizer.UI/icons/@(icon).png" /></button>;

    static string Px(double v) => v.ToString("0.##", CultureInfo.InvariantCulture) + "px";
    static string Pc(double v) => v.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    static DateTime Monday(DateTime d) => d.Date.AddDays(-(((int)d.DayOfWeek + 6) % 7));

    List<DateTime> Days()
    {
        if (S.View == ViewMode.Day) return new() { S.CurrentDate.Date };
        var m = Monday(S.CurrentDate);
        return Enumerable.Range(0, S.View == ViewMode.WorkWeek ? 5 : 7).Select(i => m.AddDays(i)).ToList();
    }

    string Title => S.View switch
    {
        ViewMode.Month => S.CurrentDate.ToString("MMMM yyyy", It),
        ViewMode.Day => S.CurrentDate.ToString("dddd d MMMM yyyy", It),
        _ => Days().First().ToString("d MMM", It) + " – " + Days().Last().ToString("d MMM yyyy", It)
    };

    void Step(int dir)
    {
        S.CurrentDate = S.View switch
        {
            ViewMode.Day => S.CurrentDate.AddDays(dir),
            ViewMode.Month => S.CurrentDate.AddMonths(dir),
            _ => S.CurrentDate.AddDays(7 * dir)
        };
        S.Navigate();
    }

    void SetKey(ColorRule r, ChangeEventArgs e) { r.Key = e.Value?.ToString() ?? ""; S.Touch(); }
    void SetColor(ColorRule r, ChangeEventArgs e) { r.Color = e.Value?.ToString() ?? "#9e9e9e"; S.Touch(); }
    void AddRule() { S.Rules.Add(new ColorRule { Key = "@nuovo.it", Color = "#ff9800" }); S.Touch(); }

    void Today() { S.CurrentDate = DateTime.Today; S.Navigate(); }
    void OpenDay(DateTime d) { S.CurrentDate = d; S.View = ViewMode.Day; S.Navigate(); }

    System.Threading.Timer nowTick; // ridisegna ogni minuto: sposta la linea dell'ora corrente
    protected override void OnInitialized() { S.Changed += OnChanged; _ = CheckUpdate(false); nowTick = new(_ => OnChanged(), null, 60000, 60000); }

    (Version Version, string ZipUrl)? upd; string updMsg; bool updBusy;
    async Task CheckUpdate(bool manual)
    {
        updMsg = null;
        try
        {
            upd = await UpdateHelper.CheckAsync();
            if (upd == null && manual) updMsg = "Hai già l'ultima versione.";
        }
        catch (Exception ex) { if (manual) updMsg = "Controllo non riuscito: " + ex.Message; } // all'avvio, senza rete, resta muto
        await InvokeAsync(StateHasChanged);
    }
    async Task DoUpdate()
    {
        updBusy = true; updMsg = "Scarico l'aggiornamento…"; StateHasChanged();
        try { await UpdateHelper.ApplyAsync(upd.Value.ZipUrl); }
        catch (Exception ex) { updBusy = false; updMsg = "Aggiornamento non riuscito: " + ex.Message; }
    }
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() { S.Changed -= OnChanged; self?.Dispose(); nowTick?.Dispose(); }

    ViewMode? lastView;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (S.View != lastView) { lastView = S.View; await JS.InvokeVoidAsync("calendizer.scrollToDay"); } // all'avvio e al cambio vista si riparte dalle 8:00
        if (!first) return;
        self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("calendizer.init", self);
        await JS.InvokeVoidAsync("calendizer.setTheme", S.Theme);
    }

    async Task SetTheme(string t)
    {
        S.Theme = t;
        await JS.InvokeVoidAsync("calendizer.setTheme", t);
    }

    [JSInvokable]
    public void Move(string id, string slot)
    {
        var p = slot.Split('|');
        S.Move(id, DateTime.ParseExact(p[0], "yyyy-MM-dd", CultureInfo.InvariantCulture), int.Parse(p[1]));
    }

    [JSInvokable]
    public void Resize(string id, int minutes) => S.Resize(id, minutes);

    [JSInvokable]
    public void External(string slot)
    {
        var p = slot.Split('|');
        S.RaiseExternalDrop(DateTime.ParseExact(p[0], "yyyy-MM-dd", CultureInfo.InvariantCulture), int.Parse(p[1]));
    }
